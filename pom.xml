<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.LiQiyeDev (not com.botmaker.session) on purpose, exactly as in botmaker-shared:
      JitPack always serves this repo as com.github.LiQiyeDev:botmaker-session:<tag> regardless of the pom, so
      matching that here makes the umbrella reactor's GAV identical to the published GAV. One dependency line
      in the SDK/Studio then resolves locally (reactor, 0.0.0-SNAPSHOT) *and* from JitPack (a real tag). The
      version below is cosmetic — JitPack overrides it with the git tag on tag builds.
    -->
    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-session</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <!--
      Private display sessions: a bot drives a nested :N X server (Xephyr or gamescope) that owns its own
      pointer, keyboard focus and window stack, so input is background-safe and the user keeps their desktop.
      A standalone library — it must never depend on botmaker-sdk or botmaker-studio (see CLAUDE.md).
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Defaults to the snapshot the reactor (and a local `mvn install`) produces; jitpack.yml injects the
          released shared tag via -D so a JitPack build resolves a real one. Same contract as sdk/studio.

          The injection only reaches CONSUMERS because of flatten-maven-plugin below: Maven publishes the
          COMMITTED pom, not the effective one, so before flatten the published pom said
          botmaker-shared:${botmaker.shared.version} with the property still at 0.0.0-SNAPSHOT and nothing
          downstream could resolve it. See the plugin comment.
        -->
        <botmaker.shared.version>0.0.0-SNAPSHOT</botmaker.shared.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          The native window/input plumbing (capture.*) and the launch stack this module drives.

          The exclusion is what makes "standalone" true rather than aspirational: shared puts OpenCV
          (~100 MB of natives) at compile scope so Studio gets the matching stack transitively without
          depending on the SDK. The session stack touches it not at all — only capture.*, launch.*, Diag and
          Executables — so a consumer who wants a private display is not made to download a vision engine to
          get one. Verified rather than assumed: nothing under capture/ or launch/ links an org.opencv type,
          so no reachable path can NoClassDefFoundError on it.

          There is no Tess4J exclusion any more: com.botmaker.shared.ocr and its Tesseract dependency moved to
          botmaker-sdk in SDK 1.2.0, so shared no longer offers an OCR engine to exclude.

          dadb is deliberately NOT excluded, and the reason is a real code path rather than tidiness:
          HostSession.launch delegates to shared's Launcher.start, which for an emu-app: target dispatches to
          EmulatorAppLauncher → emulator.AdbDevice → dadb. Excluding it would leave that one launch kind
          throwing NoClassDefFoundError for a standalone consumer. It is a small pure-JVM ADB client, not a
          native payload, so the cost is a couple of MB (it does drag kotlin-stdlib along).
        -->
        <dependency>
            <groupId>com.github.LiQiyeDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.openpnp</groupId>
                    <artifactId>opencv</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- JNA: this module opens its own X11 connections (X11/XTest bindings live in shared.capture.linux). -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- PIN THE COMPILER. Redundant locally, load-bearing on JitPack: its Maven defaults
                 maven-compiler-plugin to 3.1, which predates maven.compiler.release (3.6) and so ignores
                 the property above and builds with source 5 — "Source option 5 is no longer supported".
                 This module and botmaker-studio-api both stopped building on JitPack on 2026-09-02 for
                 exactly that reason, taking the sdk down with them for two days. Do not remove it because
                 a local build does not need it; botmaker-studio-api/pom.xml carries the full account.
                 3.11.0 rather than a newer one: 3.12.0 raised the plugin's own Maven prerequisite to
                 3.6.3, which JitPack's Maven does not meet — v0.0.11 pinned 3.13.0 and failed there. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>

            <!-- Flatten Plugin: publish a pom whose ${...} are already resolved.

                 Without it, `mvn install -Dbotmaker.shared.version=v0.0.18` (what jitpack.yml runs) affects
                 only this build's own resolution — Maven installs the COMMITTED pom, so the published
                 botmaker-session:<tag> declared botmaker-shared:0.0.0-SNAPSHOT and could not be resolved by
                 anyone without a local build in ~/.m2. Flatten writes target/.flattened-pom.xml with the
                 effective values and installs that instead.

                 flattenMode=oss drops build+profiles (this module has neither that a consumer reads) and
                 strips repositories, hence the explicit keep — the jitpack.io repo above is how a consumer
                 reaches the transitive shared. Do not copy this to botmaker-shared: its OS-activated native
                 profiles are part of what consumers resolve. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <!-- Held at 1.4.1 for JitPack, NOT stale: 1.5.0 declares a Maven 3.5.4 prerequisite and
                     1.6.0 declares 3.6.3, and JitPack's build image runs older than 3.6.3 — v0.0.7/v1.0.25
                     were burned finding that out ("requires Maven version 3.6.3", build failed before it
                     published anything). 1.4.1 needs only 3.2.5 and supports the same flattenMode and
                     pomElements config used here. Do not bump without proving JitPack's mvn version. -->
                <version>1.4.1</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <repositories>keep</repositories>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
